<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 공개 영화(CC 라이선스)를 스트리밍으로 재생 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 조회 권한: 현재 공조·조명 상태를 읽어 종료 시 원래대로 돌려놓는 데 사용 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />

    <!-- 제어 권한: 포털 기준 '준비 중'. 앱 마켓과 사전 협의·승인된 경우에만 심사를 통과함.
         공모전에서 써도 되는지는 설명회에서 확인할 것. -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cabin4D">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- landscape: 앱 창 2칸을 모두 써서 넓은 화면으로 재생 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
